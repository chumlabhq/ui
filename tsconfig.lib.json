{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "types": ["vite/client"]
  },
  // Component directories only. Every library component is a directory; the
  // loose files beside them are the site's, and excluding those by name is how
  // AnnouncementBanner.d.ts shipped when it was added and never listed.
  "include": ["src/index.ts", "src/components/*/**/*", "src/utils"],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/pages",
    "src/brand",
    "src/contexts",
    "src/redux",
    "src/components/BrandLogo",
    "src/components/Reveal",
    "src/components/ui",
    "src/App.tsx",
    "src/main.tsx"
  ]
}
