{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "types": ["vite/client"]
  },
  "include": ["src/index.ts", "src/components", "src/utils"],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/pages",
    "src/brand",
    "src/contexts",
    "src/redux",
    "src/components/BrandLogo",
    "src/components/SiteHeader.tsx",
    "src/components/SiteFooter.tsx",
    "src/components/BuyMeCoffee.tsx",
    "src/components/useBuyMeCoffee.ts",
    "src/components/UserMenu.tsx",
    "src/components/CatalogSection.tsx",
    "src/components/GetStartedSection.tsx",
    "src/components/ChumlabComparisonSection.tsx",
    "src/components/WhyChumlabSection.tsx",
    "src/components/TypographicCover.tsx",
    "src/components/FaqLogoIcon.tsx",
    "src/App.tsx",
    "src/main.tsx"
  ]
}
