  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build:lib",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "node scripts/assert-typecheck.mjs",
    "verify:dist-records": "node scripts/assert-dist-records.mjs",
    "verify:bundle-size": "node scripts/assert-bundle-size.mjs",
    "verify:css-names": "node scripts/assert-css-names.mjs",
    "verify:css-names:self-check": "node scripts/assert-css-names.mjs --self-check",
    "verify:packaging": "node scripts/assert-packaging.mjs",
    "verify:packaging:self-check": "node scripts/assert-packaging.mjs --self-check",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "node scripts/run-vitest.mjs",
    "test:contracts": "vitest run --project=contracts",
    "test:unit": "vitest run --project=unit",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=chromium",
    "test:e2e:ui": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --ui",
    "test:e2e:headed": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --headed",
    "test:e2e:debug": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --debug",
    "test:e2e:chromium": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=chromium",
    "test:e2e:firefox": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=firefox",
    "test:e2e:webkit": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=webkit",
    "test:e2e:mobile": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:all": "npm run typecheck && node scripts/run-tests-parallel.mjs",
    "clean": "rm -rf dist",
    "build:lib": "npm run clean && npm run build:tokens && vite build --mode lib && tsc --project tsconfig.lib.json && node scripts/build-cjs-declarations.mjs && npm run build:styles",
    "postbuild:lib": "node scripts/assert-phone-bundle.mjs && node scripts/assert-flag-bundle.mjs && node scripts/assert-styles-bundle.mjs && node scripts/assert-fixture-bundle.mjs && node scripts/assert-packaging.mjs && node scripts/assert-dist-records.mjs --invalidate",
    "build:preview": "node scripts/build-preview-vendor.mjs",
    "build:llms": "node ai/build-llms-full.mjs",
    "verify:playground-removed": "node scripts/assert-playground-removed.mjs",
    "verify:playground-removed:self-check": "node scripts/assert-playground-removed.mjs --self-check",
    "build:flags": "node scripts/generate-flags.mjs",
    "prepublishOnly": "npm run build:lib",
    "prepack": "npm run build:lib && npm run build:llms",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "test:e2e:all": "node scripts/run-e2e-matrix.mjs",
    "test:e2e:visual": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=visual",
    "test:e2e:visual:update": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=visual --update-snapshots",
    "test:e2e:a11y": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=a11y-full",
    "test:e2e:matrix": "node scripts/run-e2e-matrix.mjs --report",
    "verify:consumers": "node scripts/verify-consumer-matrix.mjs",
    "verify:consumers:self-check": "node scripts/verify-consumer-matrix.mjs --self-check",
    "verify:ssr-record": "node scripts/assert-ssr-record.mjs",
    "verify:ssr-record:self-check": "node scripts/assert-ssr-record.mjs --self-check",
    "test:e2e:all:self-check": "node scripts/run-e2e-matrix.mjs --self-check",
    "test:run:self-check": "node scripts/run-vitest.mjs --self-check",
    "build:demo-snippets": "node scripts/build-demo-snippets.mjs",
    "verify:demo-snippets": "node scripts/build-demo-snippets.mjs --check",
    "verify:demo-snippets:self-check": "node scripts/build-demo-snippets.mjs --self-check",
    "verify:demo-snippets:typecheck": "node scripts/typecheck-demo-snippets.mjs",
    "verify:guide-claims": "node scripts/assert-guide-claims.mjs",
    "verify:guide-claims:self-check": "node scripts/assert-guide-claims.mjs --self-check",
    "verify:component-docs": "node scripts/build-component-docs.mjs --check",
    "verify:component-docs:self-check": "node scripts/build-component-docs.mjs --self-check"
  },
