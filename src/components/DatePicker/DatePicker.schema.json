{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DatePicker",
  "description": "A date picker component supporting single, range, and multiple date selection with calendar navigation, presets, and markers.",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "single",
        "range",
        "multiple"
      ],
      "description": "Selection mode: single date, date range, or multiple dates.",
      "default": "single"
    },
    "value": {
      "description": "Controlled selected value. Type depends on mode: Date | null (single), DateRange | null (range), Date[] | null (multiple)."
    },
    "onValueChange": {
      "type": "object",
      "description": "Callback when the selected value changes. Signature depends on mode."
    },
    "onClear": {
      "type": "object",
      "description": "() => void \u2014 Called when the clear button is clicked."
    },
    "onMonthChange": {
      "type": "object",
      "description": "(month: Date) => void \u2014 Called when the displayed month changes."
    },
    "open": {
      "type": "boolean",
      "description": "Controlled open state of the calendar popup."
    },
    "defaultOpen": {
      "type": "boolean",
      "description": "Initial open state for uncontrolled usage.",
      "default": false
    },
    "onOpenChange": {
      "type": "object",
      "description": "(open: boolean) => void"
    },
    "minDate": {
      "type": "object",
      "description": "Date \u2014 Earliest selectable date."
    },
    "maxDate": {
      "type": "object",
      "description": "Date \u2014 Latest selectable date."
    },
    "disabledDates": {
      "type": "object",
      "description": "Configuration for disabling specific dates.",
      "properties": {
        "before": {
          "type": "object",
          "description": "Date \u2014 Disable dates before this date."
        },
        "after": {
          "type": "object",
          "description": "Date \u2014 Disable dates after this date."
        },
        "disablePast": {
          "type": "boolean"
        },
        "disableFuture": {
          "type": "boolean"
        },
        "dates": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Array of specific dates to disable."
        },
        "daysOfWeek": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Days of week to disable (0=Sunday)."
        },
        "custom": {
          "type": "object",
          "description": "(date: Date) => boolean \u2014 Custom disable function."
        }
      }
    },
    "weekStartsOn": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "description": "First day of the week (0=Sunday, 1=Monday, etc.).",
      "default": 0
    },
    "locale": {
      "type": "object",
      "description": "date-fns Locale object for internationalization."
    },
    "numberOfMonths": {
      "type": "number",
      "description": "Number of months to display simultaneously.",
      "default": 1
    },
    "dateFormat": {
      "type": "string",
      "description": "Date format string (date-fns format).",
      "default": "MMM d, yyyy"
    },
    "showTodayIndicator": {
      "type": "boolean",
      "description": "Highlights today's date in the calendar.",
      "default": true
    },
    "showTodayButton": {
      "type": "boolean",
      "description": "Shows a 'Today' button in the calendar footer.",
      "default": false
    },
    "todayAction": {
      "type": "boolean",
      "description": "Whether clicking 'Today' selects today's date.",
      "default": false
    },
    "showWeekNumbers": {
      "type": "boolean",
      "description": "Shows week numbers in the calendar.",
      "default": false
    },
    "showOutsideDays": {
      "type": "boolean",
      "description": "Shows days from adjacent months.",
      "default": true
    },
    "outsideDaysSelectable": {
      "type": "boolean",
      "description": "Whether outside days can be selected.",
      "default": true
    },
    "fixedWeeks": {
      "type": "boolean",
      "description": "Always shows 6 weeks per month for consistent height.",
      "default": false
    },
    "showPresets": {
      "type": "boolean",
      "description": "Shows preset date selection buttons.",
      "default": false
    },
    "presets": {
      "type": "array",
      "description": "Array of date presets.",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "getValue": {
            "type": "object",
            "description": "() => Date | DateRange | Date[]"
          }
        },
        "required": [
          "label",
          "getValue"
        ]
      }
    },
    "markers": {
      "type": "array",
      "description": "Array of date markers to display on the calendar.",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "object",
            "description": "Date"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        },
        "required": [
          "date",
          "label"
        ]
      }
    },
    "showMarkerIndicator": {
      "type": "boolean",
      "description": "Shows dots on marked dates.",
      "default": true
    },
    "showMarkerTooltip": {
      "type": "boolean",
      "description": "Shows tooltips on marked dates.",
      "default": true
    },
    "id": {
      "type": "string",
      "description": "HTML id attribute."
    },
    "name": {
      "type": "string",
      "description": "Form field name."
    },
    "placeholder": {
      "type": "string",
      "description": "Placeholder text for the trigger input."
    },
    "disabled": {
      "type": "boolean",
      "description": "Disables the date picker.",
      "default": false
    },
    "error": {
      "type": "boolean",
      "description": "Displays error state.",
      "default": false
    },
    "errorMessage": {
      "type": "object",
      "description": "React.ReactNode \u2014 Error message."
    },
    "label": {
      "type": "object",
      "description": "React.ReactNode \u2014 Label above the trigger."
    },
    "description": {
      "type": "object",
      "description": "React.ReactNode \u2014 Description text."
    },
    "success": {
      "type": "boolean",
      "description": "Displays success state.",
      "default": false
    },
    "successMessage": {
      "type": "object",
      "description": "React.ReactNode \u2014 Success message."
    },
    "loading": {
      "type": "boolean",
      "description": "Shows loading state.",
      "default": false
    },
    "clearable": {
      "type": "boolean",
      "description": "Shows a clear button."
    },
    "required": {
      "type": "boolean",
      "description": "Marks the field as required.",
      "default": false
    },
    "fullWidth": {
      "type": "boolean",
      "description": "Stretches the date picker to fill its container width.",
      "default": false
    },
    "showClearButton": {
      "type": "boolean",
      "description": "Shows the clear button in the trigger.",
      "default": true
    },
    "showCalendarIcon": {
      "type": "boolean",
      "description": "Shows the calendar icon in the trigger.",
      "default": true
    },
    "calendarIcon": {
      "type": "object",
      "description": "React.ReactNode \u2014 Custom calendar icon."
    },
    "clearIcon": {
      "type": "object",
      "description": "React.ReactNode \u2014 Custom clear icon."
    },
    "prevMonthIcon": {
      "type": "object",
      "description": "React.ReactNode \u2014 Custom previous month icon."
    },
    "nextMonthIcon": {
      "type": "object",
      "description": "React.ReactNode \u2014 Custom next month icon."
    },
    "prevYearIcon": {
      "type": "object",
      "description": "React.ReactNode \u2014 Custom previous year icon."
    },
    "nextYearIcon": {
      "type": "object",
      "description": "React.ReactNode \u2014 Custom next year icon."
    },
    "todayIcon": {
      "type": "object",
      "description": "React.ReactNode \u2014 Custom today button icon."
    },
    "monthDropdownSelectedIcon": {
      "type": "object",
      "description": "React.ReactNode \u2014 Icon for selected month in dropdown."
    },
    "yearDropdownSelectedIcon": {
      "type": "object",
      "description": "React.ReactNode \u2014 Icon for selected year in dropdown."
    },
    "classes": {
      "type": "object",
      "description": "CSS class overrides for date picker sub-elements.",
      "properties": {
        "root": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "clearTrigger": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "header": {
          "type": "string"
        },
        "row": {
          "type": "string"
        },
        "navButton": {
          "type": "string"
        },
        "listRow": {
          "type": "string"
        },
        "list": {
          "type": "string"
        },
        "listHeader": {
          "type": "string"
        },
        "weekday": {
          "type": "string"
        },
        "item": {
          "type": "string"
        },
        "weekNumber": {
          "type": "string"
        },
        "presetGroup": {
          "type": "string"
        },
        "presetTrigger": {
          "type": "string"
        },
        "footer": {
          "type": "string"
        },
        "todayTrigger": {
          "type": "string"
        },
        "markerIndicator": {
          "type": "string"
        },
        "markerTooltip": {
          "type": "string"
        },
        "monthSelect": {
          "type": "string"
        },
        "yearSelect": {
          "type": "string"
        },
        "subContent": {
          "type": "string"
        },
        "subItem": {
          "type": "string"
        }
      }
    },
    "unstyled": {
      "type": "boolean",
      "description": "Removes all default styling.",
      "default": false
    },
    "portalContainer": {
      "type": "object",
      "description": "HTMLElement | null \u2014 Portal container for the calendar popup."
    },
    "lockScroll": {
      "type": "boolean",
      "description": "Locks body scroll when the calendar is open.",
      "default": false
    },
    "dropdownZIndex": {
      "type": "number",
      "description": "Z-index of the calendar popup.",
      "default": 50
    },
    "dropdownPosition": {
      "type": "string",
      "enum": [
        "top",
        "bottom"
      ],
      "description": "Vertical placement of the calendar popup.",
      "default": "bottom"
    },
    "forceDropdownPosition": {
      "type": "boolean",
      "description": "Locks the calendar to the specified dropdownPosition without auto-flipping.",
      "default": false
    },
    "dropdownGap": {
      "type": "number",
      "description": "Gap in pixels between trigger and calendar popup.",
      "default": 4
    },
    "keepMounted": {
      "type": "boolean",
      "description": "Keep the calendar DOM mounted when closed.",
      "default": false
    },
    "reduceMotion": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "const": "auto"
        }
      ],
      "description": "Controls motion preferences. 'auto' respects OS setting.",
      "default": "auto"
    }
  },
  "required": []
}
