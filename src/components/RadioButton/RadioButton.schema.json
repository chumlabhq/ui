{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RadioButton",
  "description": "A radio button component with RadioButton and RadioGroup for single-selection within a group.",
  "type": "object",
  "oneOf": [
    {
      "title": "RadioGroup",
      "description": "Props for the RadioGroup container.",
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "description": "Currently selected value."
        },
        "defaultValue": {
          "type": "string",
          "description": "Initial selected value for uncontrolled usage.",
          "default": ""
        },
        "onValueChange": {
          "type": "object",
          "description": "(value: string) => void - Fires when the selected value changes.",
          "x-tsType": "((value: string) => void) | undefined"
        },
        "onFocus": {
          "type": "object",
          "description": "(event: FocusEvent<HTMLInputElement>) => void - Fires when a radio receives focus.",
          "x-tsType": "((event: FocusEvent<HTMLInputElement, Element>) => void) | undefined"
        },
        "onBlur": {
          "type": "object",
          "description": "(event: FocusEvent<HTMLInputElement>) => void - Fires when a radio loses focus.",
          "x-tsType": "((event: FocusEvent<HTMLInputElement, Element>) => void) | undefined"
        },
        "label": {
          "type": "object",
          "description": "React.ReactNode - Text label for the group.",
          "x-tsType": "ReactNode"
        },
        "description": {
          "type": "object",
          "description": "React.ReactNode - Helper text for the group.",
          "x-tsType": "ReactNode"
        },
        "name": {
          "type": "string",
          "description": "Field name for form submission."
        },
        "required": {
          "type": "boolean",
          "description": "Required field indicator.",
          "default": false
        },
        "disabled": {
          "type": "boolean",
          "description": "Disables all radio buttons in the group.",
          "default": false
        },
        "error": {
          "type": "boolean",
          "description": "Displays the group in an error state.",
          "default": false
        },
        "errorMessage": {
          "type": "object",
          "description": "React.ReactNode - Error message displayed below the group.",
          "x-tsType": "ReactNode"
        },
        "success": {
          "type": "boolean",
          "description": "Displays the group in a success state.",
          "default": false
        },
        "successMessage": {
          "type": "object",
          "description": "React.ReactNode - Success message displayed below the group.",
          "x-tsType": "ReactNode"
        },
        "loading": {
          "type": "boolean",
          "description": "Loading state.",
          "default": false
        },
        "size": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "xs",
                "sm",
                "md",
                "lg",
                "xl"
              ]
            },
            {
              "type": "number"
            }
          ],
          "description": "Size of all radio indicators.",
          "default": "md"
        },
        "orientation": {
          "type": "string",
          "enum": [
            "horizontal",
            "vertical"
          ],
          "description": "Layout orientation.",
          "default": "vertical"
        },
        "classes": {
          "type": "object",
          "description": "CSS class overrides for group sub-elements.",
          "properties": {
            "root": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "x-tsType": "RadioGroupClasses | undefined"
        },
        "unstyled": {
          "type": "boolean",
          "description": "Removes all default styling.",
          "default": false
        },
        "reduceMotion": {
          "type": [
            "boolean",
            "string"
          ],
          "description": "Controls motion preferences. 'auto' respects the user's OS setting.",
          "enum": [
            true,
            false,
            "auto"
          ],
          "default": "auto"
        },
        "children": {
          "type": "object",
          "description": "React.ReactNode - RadioButton children.",
          "x-tsType": "ReactNode"
        },
        "className": {
          "type": "string",
          "description": "Additional class names applied to the group root."
        }
      },
      "required": [
        "children"
      ]
    },
    {
      "title": "RadioButton",
      "description": "Props for an individual RadioButton within a RadioGroup.",
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "description": "Unique value for this radio option."
        },
        "label": {
          "type": "object",
          "description": "React.ReactNode - Text label rendered beside the radio.",
          "x-tsType": "ReactNode"
        },
        "description": {
          "type": "object",
          "description": "React.ReactNode - Helper text rendered below the label.",
          "x-tsType": "ReactNode"
        },
        "disabled": {
          "type": "boolean",
          "description": "Disables this radio option.",
          "default": false
        },
        "size": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "xs",
                "sm",
                "md",
                "lg",
                "xl"
              ]
            },
            {
              "type": "number"
            }
          ],
          "description": "Size of the radio indicator. Inherits the group's size when unset."
        },
        "checkedIcon": {
          "type": "object",
          "description": "React.ReactNode - Custom icon for the checked state.",
          "x-tsType": "ReactNode"
        },
        "uncheckedIcon": {
          "type": "object",
          "description": "React.ReactNode - Custom icon for the unchecked state.",
          "x-tsType": "ReactNode"
        },
        "classes": {
          "type": "object",
          "description": "CSS class overrides for radio sub-elements.",
          "properties": {
            "root": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "control": {
              "type": "string"
            },
            "itemIndicator": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "x-tsType": "RadioButtonClasses | undefined"
        },
        "className": {
          "type": "string",
          "description": "Additional class names applied to the radio root."
        }
      },
      "required": [
        "value"
      ]
    }
  ],
  "subComponents": {
    "RadioGroup": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string | undefined",
          "description": "Currently selected value."
        },
        "defaultValue": {
          "type": "string | undefined",
          "description": "Initial selected value for uncontrolled usage.",
          "default": ""
        },
        "onValueChange": {
          "type": "((value: string) => void) | undefined",
          "description": "Fires when the selected value changes. Not `onChange`."
        },
        "onFocus": {
          "type": "((event: FocusEvent<HTMLInputElement, Element>) => void) | undefined",
          "description": "Fires when a radio receives focus."
        },
        "onBlur": {
          "type": "((event: FocusEvent<HTMLInputElement, Element>) => void) | undefined",
          "description": "Fires when a radio loses focus."
        },
        "label": {
          "type": "ReactNode",
          "description": "Text label for the group."
        },
        "description": {
          "type": "ReactNode",
          "description": "Helper text for the group."
        },
        "name": {
          "type": "string | undefined",
          "description": "Field name for form submission."
        },
        "required": {
          "type": "boolean | undefined",
          "description": "Required field indicator.",
          "default": false
        },
        "disabled": {
          "type": "boolean | undefined",
          "description": "Disables all radio buttons in the group.",
          "default": false
        },
        "error": {
          "type": "boolean | undefined",
          "description": "Displays the group in an error state.",
          "default": false
        },
        "errorMessage": {
          "type": "ReactNode",
          "description": "Error message displayed below the group."
        },
        "success": {
          "type": "boolean | undefined",
          "description": "Displays the group in a success state.",
          "default": false
        },
        "successMessage": {
          "type": "ReactNode",
          "description": "Success message displayed below the group."
        },
        "loading": {
          "type": "boolean | undefined",
          "description": "Loading state.",
          "default": false
        },
        "size": {
          "type": "RadioButtonSize | undefined",
          "description": "Size of all radio indicators.",
          "default": "md"
        },
        "orientation": {
          "type": "\"vertical\" | \"horizontal\" | undefined",
          "description": "Layout orientation. Default: \"vertical\".",
          "default": "vertical"
        },
        "classes": {
          "type": "RadioGroupClasses | undefined",
          "description": "CSS class overrides for group sub-elements."
        },
        "unstyled": {
          "type": "boolean | undefined",
          "description": "Removes all default styling.",
          "default": false
        },
        "reduceMotion": {
          "type": "boolean | \"auto\" | undefined",
          "description": "Controls motion preferences. `\"auto\"` respects the user's OS setting.",
          "default": "auto"
        },
        "children": {
          "type": "ReactNode",
          "description": "Radio button children."
        }
      }
    }
  }
}
