{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CascadingDropdown",
  "description": "A multi-level cascading dropdown supporting single and multi-select modes, async child loading, and search filtering.",
  "type": "object",
  "properties": {
    "options": {
      "type": "array",
      "description": "Top-level options for the dropdown.",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "content": {
            "type": "object",
            "description": "React.ReactNode \u2014 Custom display content."
          },
          "selectedContent": {
            "type": "object",
            "description": "React.ReactNode \u2014 Content shown when selected."
          },
          "disabled": {
            "type": "boolean"
          },
          "children": {
            "type": "array",
            "description": "Nested child options.",
            "items": {
              "type": "object"
            }
          },
          "selectionMode": {
            "type": "string",
            "enum": [
              "single",
              "multi"
            ]
          },
          "hasChildren": {
            "type": "boolean",
            "description": "Indicates async children are available."
          }
        },
        "required": [
          "value",
          "label"
        ]
      }
    },
    "value": {
      "type": "object",
      "description": "Controlled selection value as { [parentValue]: string | string[] }."
    },
    "defaultValue": {
      "type": "object",
      "description": "Initial selection value for uncontrolled usage."
    },
    "onValueChange": {
      "type": "object",
      "description": "(value: CascadingValue, path: CascadingOption[]) => void"
    },
    "onLoadChildren": {
      "type": "object",
      "description": "(parent: CascadingOption) => Promise<CascadingOption[]> \u2014 Async child loader."
    },
    "onLoadError": {
      "type": "object",
      "description": "(error: unknown) => void \u2014 Called when async child loading fails."
    },
    "open": {
      "type": "boolean",
      "description": "Controlled open state."
    },
    "defaultOpen": {
      "type": "boolean",
      "description": "Initial open state for uncontrolled usage.",
      "default": false
    },
    "onOpenChange": {
      "type": "object",
      "description": "(open: boolean) => void"
    },
    "onBlur": {
      "type": "object",
      "description": "() => void"
    },
    "onFocus": {
      "type": "object",
      "description": "() => void"
    },
    "onKeyDown": {
      "type": "object",
      "description": "(event: React.KeyboardEvent) => void"
    },
    "id": {
      "type": "string",
      "description": "HTML id attribute."
    },
    "name": {
      "type": "string",
      "description": "Form field name."
    },
    "placeholder": {
      "type": "object",
      "description": "React.ReactNode \u2014 Placeholder content when no value is selected.",
      "default": "Select an option"
    },
    "disabled": {
      "type": "boolean",
      "description": "Disables the dropdown.",
      "default": false
    },
    "error": {
      "type": "boolean",
      "description": "Displays error state.",
      "default": false
    },
    "errorMessage": {
      "type": "object",
      "description": "React.ReactNode \u2014 Error message."
    },
    "label": {
      "type": "object",
      "description": "React.ReactNode \u2014 Label above the trigger."
    },
    "description": {
      "type": "object",
      "description": "React.ReactNode \u2014 Description text."
    },
    "success": {
      "type": "boolean",
      "description": "Displays success state.",
      "default": false
    },
    "successMessage": {
      "type": "object",
      "description": "React.ReactNode \u2014 Success message."
    },
    "required": {
      "type": "boolean",
      "description": "Marks the field as required.",
      "default": false
    },
    "noResultsContent": {
      "type": "object",
      "description": "React.ReactNode \u2014 Content shown when no results match.",
      "default": "No options found"
    },
    "loadingText": {
      "type": "object",
      "description": "React.ReactNode \u2014 Text shown during async loading.",
      "default": "Loading..."
    },
    "shimmerCount": {
      "type": "number",
      "description": "Number of shimmer placeholders during loading."
    },
    "loading": {
      "type": "boolean",
      "description": "Shows loading state."
    },
    "clearable": {
      "type": "boolean",
      "description": "Shows a clear button to reset the selection.",
      "default": false
    },
    "showChevron": {
      "type": "boolean",
      "description": "Shows a chevron indicator on the trigger.",
      "default": true
    },
    "showSelectedIcon": {
      "type": "boolean",
      "description": "Shows an icon on selected items.",
      "default": true
    },
    "selectedIcon": {
      "type": "object",
      "description": "React.ReactNode \u2014 Custom icon for selected items."
    },
    "checkboxIcon": {
      "type": "object",
      "description": "React.ReactNode \u2014 Custom checkbox icon for multi-select."
    },
    "fullWidth": {
      "type": "boolean",
      "description": "Stretches the dropdown to fill its container width.",
      "default": false
    },
    "submenuPosition": {
      "type": "string",
      "enum": [
        "right",
        "left"
      ],
      "description": "Horizontal position of submenus.",
      "default": "right"
    },
    "dropdownPosition": {
      "type": "string",
      "enum": [
        "top",
        "bottom"
      ],
      "description": "Vertical position of the dropdown.",
      "default": "bottom"
    },
    "closeOnSelect": {
      "type": "boolean",
      "description": "Closes the dropdown after an item is selected.",
      "default": true
    },
    "classes": {
      "type": "object",
      "description": "CSS class overrides for dropdown sub-elements.",
      "properties": {
        "root": {
          "type": "string"
        },
        "control": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "item": {
          "type": "string"
        },
        "subContent": {
          "type": "string"
        },
        "subPositioner": {
          "type": "string"
        },
        "subItem": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "itemIcon": {
          "type": "string"
        },
        "itemIndicator": {
          "type": "string"
        },
        "itemControl": {
          "type": "string"
        },
        "empty": {
          "type": "string"
        },
        "loading": {
          "type": "string"
        },
        "clearTrigger": {
          "type": "string"
        },
        "loadingItem": {
          "type": "string"
        },
        "searchControl": {
          "type": "string"
        },
        "searchInput": {
          "type": "string"
        },
        "searchIcon": {
          "type": "string"
        },
        "subSearchControl": {
          "type": "string"
        },
        "subSearchInput": {
          "type": "string"
        },
        "subSearchIcon": {
          "type": "string"
        }
      }
    },
    "unstyled": {
      "type": "boolean",
      "description": "Removes all default styling.",
      "default": false
    },
    "lockScroll": {
      "type": "boolean",
      "description": "Locks body scroll when the dropdown is open.",
      "default": false
    },
    "portalContainer": {
      "type": "object",
      "description": "HTMLElement | null \u2014 Portal container for the dropdown."
    },
    "dropdownZIndex": {
      "type": "number",
      "description": "Z-index of the dropdown.",
      "default": 50
    },
    "dropdownGap": {
      "type": "number",
      "description": "Gap in pixels between trigger and dropdown.",
      "default": 4
    },
    "keepMounted": {
      "type": "boolean",
      "description": "Keep the dropdown DOM mounted when closed.",
      "default": false
    },
    "className": {
      "type": "string",
      "description": "CSS class for the root element."
    },
    "style": {
      "type": "object",
      "description": "CSSProperties \u2014 Inline styles."
    },
    "ClearIcon": {
      "type": "object",
      "description": "React.ComponentType<{ className?: string }> \u2014 Custom clear icon component."
    },
    "renderTrigger": {
      "type": "object",
      "description": "(props: CascadingDropdownTriggerRenderProps) => React.ReactNode \u2014 Custom trigger render function."
    },
    "showMenuSearch": {
      "type": "boolean",
      "description": "Show a search input inside the main menu.",
      "default": false
    },
    "showSubmenuSearch": {
      "type": "boolean",
      "description": "Show a search input inside submenus.",
      "default": false
    },
    "menuSearchPlaceholder": {
      "type": "string",
      "description": "Placeholder text for the main menu search input.",
      "default": "Search..."
    },
    "submenuSearchPlaceholder": {
      "type": "string",
      "description": "Placeholder text for the submenu search input.",
      "default": "Search..."
    },
    "onMenuSearch": {
      "type": "object",
      "description": "(query: string) => Promise<CascadingOption[]> \u2014 Async search for main menu."
    },
    "onSubmenuSearch": {
      "type": "object",
      "description": "(query: string, parent: CascadingOption) => Promise<CascadingOption[]> \u2014 Async search for submenu."
    },
    "searchDebounceMs": {
      "type": "number",
      "description": "Debounce delay in ms for async search callbacks.",
      "default": 300
    },
    "SearchIcon": {
      "type": "object",
      "description": "React.ComponentType<{ className?: string }> \u2014 Custom search icon component."
    },
    "menuSearchAriaLabel": {
      "type": "string",
      "description": "Accessible label for the menu search input.",
      "default": "Search menu"
    },
    "submenuSearchAriaLabel": {
      "type": "string",
      "description": "Accessible label for the submenu search input.",
      "default": "Search submenu"
    },
    "aria-label": {
      "type": "string",
      "description": "Accessible label for the dropdown."
    }
  },
  "required": [
    "options"
  ]
}
