{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CascadingDropdown",
  "description": "A multi-level cascading dropdown supporting single and multi-select modes, async child loading, and search filtering.",
  "type": "object",
  "properties": {
    "options": {
      "type": "array",
      "description": "Top-level options for the dropdown.",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "content": {
            "type": "object",
            "description": "React.ReactNode — Custom display content."
          },
          "selectedContent": {
            "type": "object",
            "description": "React.ReactNode — Content shown when selected."
          },
          "disabled": {
            "type": "boolean"
          },
          "children": {
            "type": "array",
            "description": "Nested child options.",
            "items": {
              "type": "object"
            }
          },
          "selectionMode": {
            "type": "string",
            "enum": [
              "single",
              "multi"
            ]
          },
          "hasChildren": {
            "type": "boolean",
            "description": "Indicates async children are available."
          }
        },
        "required": [
          "value",
          "label"
        ]
      },
      "default": []
    },
    "value": {
      "type": "object",
      "description": "Controlled selection value as { [parentValue]: string | string[] }.",
      "x-tsType": "CascadingValue | undefined"
    },
    "defaultValue": {
      "type": "object",
      "description": "Initial selection value for uncontrolled usage.",
      "x-tsType": "CascadingValue | undefined"
    },
    "onValueChange": {
      "type": "object",
      "description": "(value: CascadingValue, path: CascadingOption[]) => void",
      "x-tsType": "((value: CascadingValue, path: CascadingOption[]) => void) | undefined"
    },
    "loadChildren": {
      "type": "object",
      "description": "(parent: CascadingOption) => Promise<CascadingOption[]> — Async child loader.",
      "x-tsType": "((parent: CascadingOption) => Promise<CascadingOption[]>) | undefined"
    },
    "onLoadError": {
      "type": "object",
      "description": "(error: unknown) => void — Called when async child loading fails.",
      "x-tsType": "((error: unknown) => void) | undefined"
    },
    "open": {
      "type": "boolean",
      "description": "Controlled open state."
    },
    "defaultOpen": {
      "type": "boolean",
      "description": "Initial open state for uncontrolled usage.",
      "default": false
    },
    "onOpenChange": {
      "type": "object",
      "description": "(open: boolean) => void",
      "x-tsType": "((open: boolean) => void) | undefined"
    },
    "onBlur": {
      "type": "object",
      "description": "(event: FocusEvent<HTMLElement>) => void — Fires when the trigger loses focus, with the native focus event.",
      "x-tsType": "((event: FocusEvent<HTMLElement, Element>) => void) | undefined"
    },
    "onFocus": {
      "type": "object",
      "description": "(event: FocusEvent<HTMLElement>) => void — Fires when the trigger takes focus, with the native focus event.",
      "x-tsType": "((event: FocusEvent<HTMLElement, Element>) => void) | undefined"
    },
    "onKeyDown": {
      "type": "object",
      "description": "(event: React.KeyboardEvent) => void",
      "x-tsType": "((event: KeyboardEvent<Element>) => void) | undefined"
    },
    "id": {
      "type": "string",
      "description": "HTML id attribute.",
      "x-defaultSource": "`${dropdownId}-trigger`"
    },
    "name": {
      "type": "string",
      "description": "Form field name."
    },
    "placeholder": {
      "type": "object",
      "description": "React.ReactNode — Placeholder content when no value is selected.",
      "default": "Select an option",
      "x-tsType": "ReactNode"
    },
    "disabled": {
      "type": "boolean",
      "description": "Disables the dropdown.",
      "default": false
    },
    "error": {
      "type": "boolean",
      "description": "Displays error state.",
      "default": false
    },
    "errorMessage": {
      "type": "object",
      "description": "React.ReactNode — Error message.",
      "x-tsType": "ReactNode"
    },
    "label": {
      "type": "object",
      "description": "React.ReactNode — Label above the trigger.",
      "x-tsType": "ReactNode"
    },
    "description": {
      "type": "object",
      "description": "React.ReactNode — Description text.",
      "x-tsType": "ReactNode"
    },
    "success": {
      "type": "boolean",
      "description": "Displays success state.",
      "default": false
    },
    "successMessage": {
      "type": "object",
      "description": "React.ReactNode — Success message.",
      "x-tsType": "ReactNode"
    },
    "required": {
      "type": "boolean",
      "description": "Marks the field as required.",
      "default": false
    },
    "emptyContent": {
      "type": "object",
      "description": "React.ReactNode — Content shown when no results match.",
      "default": "No options found",
      "x-tsType": "ReactNode"
    },
    "loadingContent": {
      "type": "object",
      "description": "React.ReactNode — Text shown during async loading.",
      "default": "Loading...",
      "x-tsType": "ReactNode"
    },
    "shimmerCount": {
      "type": "number",
      "description": "Number of shimmer placeholders during loading."
    },
    "loading": {
      "type": "boolean",
      "description": "Shows loading state."
    },
    "clearable": {
      "type": "boolean",
      "description": "Shows a clear button to reset the selection.",
      "default": false
    },
    "showChevron": {
      "type": "boolean",
      "description": "Shows a chevron indicator on the trigger.",
      "default": true
    },
    "showSelectedIcon": {
      "type": "boolean",
      "description": "Shows an icon on selected items.",
      "default": true
    },
    "selectedIcon": {
      "type": "object",
      "description": "React.ReactNode — Custom icon for selected items.",
      "x-tsType": "ReactNode"
    },
    "checkboxIcon": {
      "type": "object",
      "description": "React.ReactNode — Custom checkbox icon for multi-select.",
      "x-tsType": "ReactNode"
    },
    "fullWidth": {
      "type": "boolean",
      "description": "Stretches the dropdown to fill its container width.",
      "default": false
    },
    "submenuSide": {
      "type": "string",
      "enum": [
        "start",
        "end"
      ],
      "description": "The side submenus open on, logical: `\"end\"` is the right in a left-to-right page and the left in a right-to-left one, read from the closest `dir` attribute when the submenu opens, else the document's. RTL is not supported in 0.1.0; the values are logical so they need no rename when it is.",
      "default": "end"
    },
    "dropdownSide": {
      "type": "string",
      "enum": [
        "top",
        "bottom"
      ],
      "description": "Vertical position of the dropdown.",
      "default": "bottom"
    },
    "closeOnSelect": {
      "type": "boolean",
      "description": "Closes the dropdown after an item is selected.",
      "default": true
    },
    "classes": {
      "type": "object",
      "description": "CSS class overrides for dropdown sub-elements.",
      "properties": {
        "root": {
          "type": "string"
        },
        "control": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "item": {
          "type": "string"
        },
        "subContent": {
          "type": "string"
        },
        "subPositioner": {
          "type": "string"
        },
        "subItem": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "itemIcon": {
          "type": "string"
        },
        "itemIndicator": {
          "type": "string"
        },
        "itemControl": {
          "type": "string"
        },
        "empty": {
          "type": "string"
        },
        "loading": {
          "type": "string"
        },
        "clearTrigger": {
          "type": "string"
        },
        "loadingItem": {
          "type": "string"
        },
        "searchControl": {
          "type": "string"
        },
        "searchInput": {
          "type": "string"
        },
        "searchIcon": {
          "type": "string"
        },
        "subSearchControl": {
          "type": "string"
        },
        "subSearchInput": {
          "type": "string"
        },
        "subSearchIcon": {
          "type": "string"
        }
      },
      "x-tsType": "CascadingDropdownClasses | undefined"
    },
    "unstyled": {
      "type": "boolean",
      "description": "Removes all default styling.",
      "default": false
    },
    "lockScroll": {
      "type": "boolean",
      "description": "Locks body scroll when the dropdown is open.",
      "default": false
    },
    "portalContainer": {
      "type": "object",
      "description": "HTMLElement | null — Portal container for the dropdown.",
      "x-tsType": "HTMLElement | null | undefined"
    },
    "dropdownZIndex": {
      "type": "number",
      "description": "Z-index of the dropdown.",
      "default": 50
    },
    "dropdownOffset": {
      "type": "number",
      "description": "Gap in pixels between trigger and dropdown.",
      "default": 4
    },
    "keepMounted": {
      "type": "boolean",
      "description": "Keep the dropdown DOM mounted when closed.",
      "default": false
    },
    "className": {
      "type": "string",
      "description": "CSS class for the root element."
    },
    "style": {
      "type": "object",
      "description": "CSSProperties — Inline styles.",
      "x-tsType": "CSSProperties | undefined"
    },
    "clearIcon": {
      "type": "object",
      "description": "ReactNode — Replaces the clear button's glyph. Rendered as given.",
      "x-tsType": "ReactNode"
    },
    "renderTrigger": {
      "type": "object",
      "description": "(triggerProps: CascadingDropdownTriggerRenderProps, state: CascadingDropdownTriggerState) => ReactNode - Custom render function for the trigger element. Spread triggerProps onto a <button>; draw from state (isOpen, displayValue, placeholder).",
      "x-tsType": "((triggerProps: CascadingDropdownTriggerRenderProps, state: CascadingDropdownTriggerState) => ReactNode) | undefined"
    },
    "showMenuSearch": {
      "type": "boolean",
      "description": "Show a search input inside the main menu.",
      "default": false
    },
    "showSubmenuSearch": {
      "type": "boolean",
      "description": "Show a search input inside submenus.",
      "default": false
    },
    "menuSearchPlaceholder": {
      "type": "string",
      "description": "Placeholder text for the main menu search input.",
      "default": "Search..."
    },
    "submenuSearchPlaceholder": {
      "type": "string",
      "description": "Placeholder text for the submenu search input.",
      "default": "Search..."
    },
    "searchMenu": {
      "type": "object",
      "description": "(query: string) => Promise<CascadingOption[]> — Async search for main menu.",
      "x-tsType": "(query: string) => Promise<CascadingOption[]>"
    },
    "searchSubmenu": {
      "type": "object",
      "description": "(query: string, parent: CascadingOption) => Promise<CascadingOption[]> — Async search for submenu.",
      "x-tsType": "(query: string, parent: CascadingOption) => Promise<CascadingOption[]>"
    },
    "searchDebounce": {
      "type": "number",
      "description": "Debounce delay in ms for async search callbacks.",
      "default": 300
    },
    "searchIcon": {
      "type": "object",
      "description": "ReactNode — Replaces the search field's magnifier. Rendered as given; `classes.searchIcon` styles the default one.",
      "x-tsType": "ReactNode"
    },
    "menuSearchAriaLabel": {
      "type": "string",
      "description": "Accessible label for the menu search input.",
      "default": "Search menu"
    },
    "submenuSearchAriaLabel": {
      "type": "string",
      "description": "Accessible label for the submenu search input.",
      "default": "Search submenu"
    },
    "aria-label": {
      "type": "string",
      "description": "Accessible label for the dropdown."
    },
    "aria-labelledby": {
      "type": "string",
      "description": "Names the field by another element, and wins over `label` and `aria-label`. Lands on the trigger."
    },
    "aria-describedby": {
      "type": "string",
      "description": "Lands on the trigger, joined with the component's own error message."
    }
  },
  "required": [
    "options"
  ]
}
