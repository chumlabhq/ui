{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Checkbox",
  "description": "A checkbox input component with label, description, indeterminate state, and validation support.",
  "type": "object",
  "properties": {
    "label": {
      "type": "object",
      "description": "React.ReactNode — Text label rendered beside the checkbox.",
      "x-tsType": "ReactNode"
    },
    "description": {
      "type": "object",
      "description": "React.ReactNode — Helper text rendered below the label.",
      "x-tsType": "ReactNode"
    },
    "checked": {
      "type": "boolean",
      "description": "Controlled checked state."
    },
    "defaultChecked": {
      "type": "boolean",
      "description": "Initial checked state for uncontrolled usage.",
      "default": false
    },
    "indeterminate": {
      "type": "boolean",
      "description": "Displays the indeterminate (minus) indicator instead of a checkmark.",
      "default": false
    },
    "onValueChange": {
      "type": "object",
      "description": "(checked: boolean) => void — Fires when the checked state changes.",
      "x-tsType": "((checked: boolean) => void) | undefined"
    },
    "onFocus": {
      "type": "object",
      "description": "(event: FocusEvent) => void",
      "x-tsType": "((event: FocusEvent<HTMLInputElement, Element>) => void) | undefined"
    },
    "onBlur": {
      "type": "object",
      "description": "(event: FocusEvent) => void",
      "x-tsType": "((event: FocusEvent<HTMLInputElement, Element>) => void) | undefined"
    },
    "error": {
      "type": "boolean",
      "description": "Displays the checkbox in an error state.",
      "default": false
    },
    "errorMessage": {
      "type": "object",
      "description": "React.ReactNode — Error message displayed below the checkbox.",
      "x-tsType": "ReactNode"
    },
    "success": {
      "type": "boolean",
      "description": "Displays the checkbox in a success state.",
      "default": false
    },
    "successMessage": {
      "type": "object",
      "description": "React.ReactNode — Success message displayed below the checkbox.",
      "x-tsType": "ReactNode"
    },
    "loading": {
      "type": "boolean",
      "description": "Displays the checkbox in a loading state.",
      "default": false
    },
    "size": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "xs",
            "sm",
            "md",
            "lg",
            "xl"
          ]
        },
        {
          "type": "number"
        }
      ],
      "description": "Size of the checkbox indicator.",
      "default": "md"
    },
    "shape": {
      "type": "string",
      "enum": [
        "square",
        "rounded",
        "circle"
      ],
      "description": "Shape of the checkbox indicator.",
      "default": "rounded"
    },
    "checkedIcon": {
      "type": "object",
      "description": "React.ReactNode — Custom icon for the checked state.",
      "x-tsType": "ReactNode"
    },
    "uncheckedIcon": {
      "type": "object",
      "description": "React.ReactNode — Custom icon for the unchecked state.",
      "x-tsType": "ReactNode"
    },
    "indeterminateIcon": {
      "type": "object",
      "description": "React.ReactNode — Custom icon for the indeterminate state.",
      "x-tsType": "ReactNode"
    },
    "classes": {
      "type": "object",
      "description": "CSS class overrides for checkbox sub-elements.",
      "properties": {
        "root": {
          "type": "string"
        },
        "labelGroup": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "control": {
          "type": "string"
        },
        "itemIndicator": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "x-tsType": "CheckboxClasses | undefined"
    },
    "unstyled": {
      "type": "boolean",
      "description": "Removes all default styling.",
      "default": false
    },
    "reduceMotion": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "const": "auto"
        }
      ],
      "description": "Controls motion preferences. 'auto' respects OS setting."
    },
    "disabled": {
      "type": "boolean",
      "description": "Disables the checkbox.",
      "default": false
    },
    "name": {
      "type": "string",
      "description": "Form field name."
    },
    "value": {
      "type": "string",
      "description": "Form field value."
    },
    "id": {
      "type": "string",
      "description": "HTML id attribute."
    },
    "required": {
      "type": "boolean",
      "description": "Marks the checkbox as required.",
      "default": false
    }
  },
  "required": []
}
