{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toast",
  "description": "A notification toast component with success, warning, error, and info types, progress bar, and configurable position.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the toast."
    },
    "type": {
      "type": "string",
      "enum": [
        "success",
        "warning",
        "error",
        "info"
      ],
      "description": "Visual type/severity of the toast.",
      "default": "info"
    },
    "message": {
      "type": "object",
      "description": "React.ReactNode — Primary message content."
    },
    "description": {
      "type": "object",
      "description": "React.ReactNode — Secondary description text."
    },
    "content": {
      "type": "object",
      "description": "React.ReactNode — Custom content that replaces message and description."
    },
    "duration": {
      "type": "number",
      "description": "Auto-dismiss duration in milliseconds.",
      "default": 5000
    },
    "showProgress": {
      "type": "boolean",
      "description": "Whether to show a progress bar countdown.",
      "default": true
    },
    "progressColor": {
      "type": "string",
      "description": "Custom color for the progress bar."
    },
    "icon": {
      "type": "object",
      "description": "React.ReactNode — Custom icon replacing the default type icon."
    },
    "showCloseButton": {
      "type": "boolean",
      "description": "Whether to show a close/dismiss button.",
      "default": true
    },
    "onDismiss": {
      "type": "object",
      "description": "() => void — Fires when the toast is dismissed."
    },
    "role": {
      "type": "string",
      "enum": [
        "alert",
        "status"
      ],
      "description": "ARIA role for the toast element."
    },
    "style": {
      "type": "object",
      "description": "Inline styles applied to the toast element."
    },
    "pauseOnHover": {
      "type": "boolean",
      "description": "Whether to pause the auto-dismiss timer on hover.",
      "default": true
    },
    "closeAriaLabel": {
      "type": "string",
      "description": "Accessible label for the close button.",
      "default": "Close notification"
    },
    "classes": {
      "type": "object",
      "description": "CSS class overrides for sub-elements.",
      "properties": {
        "root": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "indicator": {
          "type": "string"
        },
        "closeTrigger": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        }
      }
    },
    "unstyled": {
      "type": "boolean",
      "description": "When true, removes all default styling.",
      "default": false
    },
    "onRemove": {
      "type": "object",
      "description": "(id: string) => void — Internal callback to remove the toast from the provider."
    }
  },
  "required": [
    "id",
    "onRemove"
  ],
  "subComponents": {
    "ToastProvider": {
      "type": "object",
      "properties": {
        "children": {
          "type": "ReactNode"
        },
        "position": {
          "type": "ToastPosition | undefined",
          "description": "Toast position on screen. Default: `\"bottom-right\"`."
        },
        "maxToasts": {
          "type": "number | undefined"
        },
        "containerClassName": {
          "type": "string | undefined"
        },
        "defaultDuration": {
          "type": "number | undefined"
        },
        "animationDuration": {
          "type": "number | undefined"
        },
        "gap": {
          "type": "number | undefined"
        },
        "zIndex": {
          "type": "number | undefined"
        },
        "dismissOnEscape": {
          "type": "boolean | undefined"
        },
        "containerAriaLabel": {
          "type": "string | undefined"
        },
        "classes": {
          "type": "ToastClasses | undefined"
        },
        "unstyled": {
          "type": "boolean | undefined"
        }
      }
    }
  }
}
