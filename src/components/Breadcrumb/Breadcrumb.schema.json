{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Breadcrumb",
  "description": "A navigation breadcrumb component with collapsible items, custom separators, tooltips, and dropdown overflow.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "description": "List of breadcrumb items to render.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the breadcrumb item."
          },
          "label": {
            "type": "string",
            "description": "Display text for the breadcrumb item."
          },
          "href": {
            "type": "string",
            "description": "Navigation URL for the breadcrumb item."
          },
          "onClick": {
            "type": "object",
            "description": "() => void \u2014 Click handler."
          },
          "icon": {
            "type": "object",
            "description": "React.ReactNode \u2014 Icon rendered beside the label."
          },
          "iconPosition": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ],
            "description": "Position of the icon relative to the label.",
            "default": "left"
          },
          "disabled": {
            "type": "boolean",
            "description": "Disables the breadcrumb item."
          },
          "content": {
            "type": "object",
            "description": "React.ReactNode \u2014 Custom content replacing the label."
          },
          "tooltip": {
            "type": "object",
            "description": "React.ReactNode \u2014 Tooltip content."
          },
          "tooltipProps": {
            "type": "object",
            "description": "Configuration for the item tooltip.",
            "properties": {
              "side": {
                "type": "string",
                "enum": [
                  "top",
                  "right",
                  "bottom",
                  "left"
                ]
              },
              "align": {
                "type": "string",
                "enum": [
                  "start",
                  "center",
                  "end"
                ]
              },
              "sideOffset": {
                "type": "number"
              },
              "maxWidth": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "delayDuration": {
                "type": "number"
              },
              "showArrow": {
                "type": "boolean"
              },
              "contentClassName": {
                "type": "string"
              },
              "contentStyle": {
                "type": "object",
                "description": "CSSProperties"
              }
            }
          }
        },
        "required": [
          "id",
          "label"
        ]
      }
    },
    "maxVisibleItems": {
      "type": "number",
      "description": "Maximum visible items before collapsing into an ellipsis dropdown.",
      "default": 4
    },
    "separator": {
      "type": "object",
      "description": "React.ReactNode \u2014 Custom separator between breadcrumb items."
    },
    "onItemClick": {
      "type": "object",
      "description": "(item: BreadcrumbItem) => void \u2014 Called when a breadcrumb item is clicked."
    },
    "aria-label": {
      "type": "string",
      "description": "Accessible label for the breadcrumb nav element."
    },
    "classes": {
      "type": "object",
      "description": "CSS class overrides for breadcrumb sub-elements.",
      "properties": {
        "root": {
          "type": "string"
        },
        "list": {
          "type": "string"
        },
        "item": {
          "type": "string"
        },
        "link": {
          "type": "string"
        },
        "separator": {
          "type": "string"
        },
        "itemIcon": {
          "type": "string"
        },
        "ellipsis": {
          "type": "string"
        },
        "ellipsisTrigger": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "collapsedItem": {
          "type": "string"
        }
      }
    },
    "unstyled": {
      "type": "boolean",
      "description": "Removes all default styling.",
      "default": false
    },
    "className": {
      "type": "string",
      "description": "CSS class for the root element."
    },
    "style": {
      "type": "object",
      "description": "CSSProperties \u2014 Inline styles for the root element."
    },
    "separatorIcon": {
      "type": "object",
      "description": "React.ComponentType<{ className?: string; style?: CSSProperties }> \u2014 Custom separator icon component."
    },
    "ellipsisIcon": {
      "type": "object",
      "description": "React.ComponentType<{ className?: string; style?: CSSProperties }> \u2014 Custom ellipsis icon component."
    },
    "iconSize": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "description": "Size of breadcrumb icons.",
      "default": 16
    },
    "showTooltips": {
      "type": "boolean",
      "description": "Enables tooltips on breadcrumb items.",
      "default": true
    },
    "tooltipPosition": {
      "type": "string",
      "enum": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "description": "Default tooltip position for all items.",
      "default": "bottom"
    },
    "tooltipOffset": {
      "type": "number",
      "description": "Default tooltip offset in pixels.",
      "default": 4
    },
    "defaultTooltipProps": {
      "type": "object",
      "description": "Default tooltip configuration for all items.",
      "properties": {
        "side": {
          "type": "string",
          "enum": [
            "top",
            "right",
            "bottom",
            "left"
          ]
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "sideOffset": {
          "type": "number"
        },
        "maxWidth": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "delayDuration": {
          "type": "number"
        },
        "showArrow": {
          "type": "boolean"
        },
        "contentClassName": {
          "type": "string"
        },
        "contentStyle": {
          "type": "object",
          "description": "CSSProperties"
        }
      }
    },
    "ellipsisTooltip": {
      "type": "object",
      "description": "React.ReactNode \u2014 Tooltip content for the ellipsis button."
    },
    "ellipsisTooltipProps": {
      "type": "object",
      "description": "Tooltip configuration for the ellipsis button."
    },
    "dropdownPosition": {
      "type": "string",
      "enum": [
        "top",
        "bottom",
        "left",
        "right"
      ],
      "description": "Position of the overflow dropdown.",
      "default": "top"
    },
    "dropdownZIndex": {
      "type": "number",
      "description": "Z-index of the overflow dropdown.",
      "default": 50
    },
    "portalContainer": {
      "type": "object",
      "description": "HTMLElement | null \u2014 Portal container for the dropdown."
    },
    "keepMounted": {
      "type": "boolean",
      "description": "Keeps the collapsed-items menu mounted while closed.",
      "default": false
    },
    "ellipsisAriaLabel": {
      "type": "string",
      "description": "Accessible label for the ellipsis button.",
      "default": "Show collapsed breadcrumb items"
    },
    "onDropdownOpenChange": {
      "type": "object",
      "description": "(open: boolean) => void \u2014 Called when the dropdown open state changes."
    }
  },
  "required": [
    "items"
  ]
}
