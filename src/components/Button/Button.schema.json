{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Button",
  "description": "A polymorphic button component that renders as button, anchor, span, or merges into a child element via asChild.",
  "type": "object",
  "properties": {
    "children": {
      "type": "object",
      "description": "React.ReactNode — Button content.",
      "x-tsType": "ReactNode"
    },
    "as": {
      "type": "string",
      "enum": [
        "button",
        "a",
        "span"
      ],
      "description": "HTML element to render as.",
      "default": "button"
    },
    "asChild": {
      "type": "boolean",
      "description": "Merges button props onto a child element via Slot.",
      "default": false
    },
    "size": {
      "type": "string",
      "enum": [
        "sm",
        "md",
        "lg"
      ],
      "description": "Sets padding, type size, gap, icon box and loader together: 28, 40 and 52px tall. Also emits data-size on the root, so CSS can target it; the attribute is a hook, not the mechanism."
    },
    "disabled": {
      "type": "boolean",
      "description": "Disables interaction and applies disabled styling."
    },
    "startIcon": {
      "type": "object",
      "description": "React.ReactNode — Icon rendered before the button label.",
      "x-tsType": "ReactNode"
    },
    "endIcon": {
      "type": "object",
      "description": "React.ReactNode — Icon rendered after the button label.",
      "x-tsType": "ReactNode"
    },
    "loading": {
      "type": "boolean",
      "description": "Shows a loading spinner and disables interaction.",
      "default": false
    },
    "loadingText": {
      "type": "object",
      "description": "React.ReactNode — Text displayed alongside the loading spinner.",
      "x-tsType": "ReactNode"
    },
    "loaderPosition": {
      "type": "string",
      "enum": [
        "start",
        "end"
      ],
      "description": "Which end of the label the loader appears at: `start` before it, `end` after it.",
      "default": "end"
    },
    "loaderSize": {
      "type": "number",
      "description": "Pixel size of the loading spinner.",
      "default": 16
    },
    "loader": {
      "type": "object",
      "description": "React.ReactNode — Custom loader element replacing the default spinner.",
      "x-tsType": "ReactNode"
    },
    "fullWidth": {
      "type": "boolean",
      "description": "Stretches the button to fill its container width.",
      "default": false
    },
    "classes": {
      "type": "object",
      "description": "CSS class overrides for button sub-elements.",
      "properties": {
        "root": {
          "type": "string"
        },
        "itemText": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "loading": {
          "type": "string"
        }
      },
      "x-tsType": "ButtonClasses | undefined"
    },
    "unstyled": {
      "type": "boolean",
      "description": "Removes all default styling, rendering a plain element.",
      "default": false
    },
    "iconAnimation": {
      "type": "string",
      "enum": [
        "none",
        "slideRight",
        "slideLeft",
        "slideUp",
        "slideDown",
        "bounce",
        "pulse",
        "spin"
      ],
      "description": "Animation applied to icons on hover.",
      "default": "none"
    },
    "animateOnHover": {
      "type": "boolean",
      "description": "Enables icon animation on hover.",
      "default": true
    },
    "animateIcon": {
      "type": "string",
      "enum": [
        "leading",
        "trailing",
        "both"
      ],
      "description": "Which icon(s) to animate.",
      "default": "trailing"
    },
    "reduceMotion": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "const": "auto"
        }
      ],
      "description": "Controls motion preferences. 'auto' respects OS setting.",
      "default": "auto"
    },
    "tooltip": {
      "type": "object",
      "description": "React.ReactNode — Tooltip content shown on hover.",
      "x-tsType": "ReactNode"
    },
    "tooltipProps": {
      "type": "object",
      "description": "Configuration for tooltip positioning and appearance.",
      "properties": {
        "side": {
          "type": "string",
          "enum": [
            "top",
            "right",
            "bottom",
            "left"
          ]
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "sideOffset": {
          "type": "number"
        },
        "maxWidth": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "delayDuration": {
          "type": "number"
        },
        "showArrow": {
          "type": "boolean"
        },
        "contentClassName": {
          "type": "string"
        },
        "contentStyle": {
          "type": "object",
          "description": "CSSProperties"
        }
      },
      "x-tsType": "ButtonTooltipProps | undefined"
    },
    "href": {
      "type": "string",
      "description": "Link destination (required when as='a')."
    },
    "target": {
      "type": "string",
      "description": "Link target attribute (when as='a')."
    },
    "rel": {
      "type": "string",
      "description": "Link rel attribute (when as='a')."
    }
  },
  "required": [],
  "subComponents": {
    "ButtonGroup": {
      "type": "object",
      "properties": {
        "children": {
          "type": "ReactNode",
          "description": "Button elements to group together."
        },
        "orientation": {
          "type": "\"vertical\" | \"horizontal\" | undefined",
          "description": "Stack direction. Default: `\"horizontal\"`.",
          "default": "horizontal"
        }
      }
    }
  }
}
